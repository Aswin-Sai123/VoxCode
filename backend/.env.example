# ==========================================
# VoxCode Backend Environment Configuration
# ==========================================
# Copy this file to .env inside the /backend directory:
# cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)

# 1. Server & Client Ports
PORT=5000
FRONTEND_URL=http://localhost:5173

# 2. Database Connection
# Use local MongoDB (mongodb://localhost:27017/voxcode) or a free MongoDB Atlas URI:
MONGODB_URI=mongodb://localhost:27017/voxcode

# 3. JWT Authentication Secrets (Can be any random secure strings)
JWT_ACCESS_SECRET=voxcode_access_token_secret_dev_key_2026
JWT_REFRESH_SECRET=voxcode_refresh_token_secret_dev_key_2026

# 4. Google Gemini API Key (Powers AI Interviewer, Resume Parsing, Code Evaluation)
# Get a 100% FREE API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Google OAuth (Optional - needed for "Sign in with Google")
# For local dev:
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# For Render production:
# GOOGLE_CALLBACK_URL=https://voxcode-backend.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

